# AgroFedly Production Environment Variables
# Copy this file to .env and populate with real values for production.
# WARNING: NEVER commit the actual .env file with real secrets to version control.

# ---------------------------------------------------------
# Security & Core Django Settings
# ---------------------------------------------------------
# SECRET_KEY must be a large random string. In production, this is mandatory.
DJANGO_SECRET_KEY=your-production-secret-key-here

# DEBUG must be set to 0 (False) in production to prevent leaking sensitive information.
DJANGO_DEBUG=0

# ALLOWED_HOSTS must be a comma-separated list of domains/IPs that can serve this app.
DJANGO_ALLOWED_HOSTS=agrofedly.com,www.agrofedly.com

# CSRF_TRUSTED_ORIGINS must be a comma-separated list of secure origins.
CSRF_TRUSTED_ORIGINS=https://agrofedly.com,https://www.agrofedly.com

# Enforce secure connections in production (redirect HTTP to HTTPS).
SECURE_SSL_REDIRECT=True

# ---------------------------------------------------------
# Database & Cache Settings
# ---------------------------------------------------------
# Required in production. Connects to PostgreSQL.
DATABASE_URL=postgres://agro_user:agro_pass@db:5432/agrofedly

# Required for WebSockets, Channels, and Celery broker/backend.
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------
# External APIs (Optional / Required depending on features)
# ---------------------------------------------------------
# OpenWeather API Key for live weather data.
WEATHER_API_KEY=your-weather-api-key-here

# OpenAI API Key for AI features (Copilot, recipes).
OPENAI_API_KEY=your-openai-api-key-here

# Required for securing API endpoints (/api/*) when DEBUG=False
API_KEY=your-api-key-here

# ---------------------------------------------------------
# Celery / Message Broker
# ---------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ---------------------------------------------------------
# Email Configuration (SMTP)
# ---------------------------------------------------------
EMAIL_URL=smtp://user:password@smtp.mailgun.org:587
