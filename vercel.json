{
  "builds": [
    {
      "src": "AgroFedly/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "templates/**",
          "staticfiles/**",
          "db.sqlite3"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "AgroFedly/wsgi.py"
    }
  ]
}